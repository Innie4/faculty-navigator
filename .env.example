# FindMyBlock — backend environment configuration (Render)
# Copy this file to ".env" for local dev, or paste these into Render's
# dashboard under your service → Environment.
#
# The frontend (public/*.html, deployed to Vercel) is static and has no
# .env of its own — see vercel.json, which proxies /api/* requests to
# this backend. That's the only "frontend config": edit the destination
# URL in vercel.json once you know your Render URL.

# --- SERVER (Render) ---

# Port the web server listens on. Render sets this automatically —
# leave it unset in Render's dashboard and let the platform supply it.
PORT=3000

# Trust Render's reverse proxy so express-rate-limit reads the real
# client IP from X-Forwarded-For instead of Render's edge IP. Render
# and most single-layer platforms (Railway, Heroku, nginx) need "1".
# Leave unset for local dev.
TRUST_PROXY=1

# --- DATABASE (Supabase Postgres) ---

# Supabase dashboard → Project Settings → Database → Connection string
# → use the "Session pooler" tab specifically (hostname contains
# ".pooler.supabase.com"). Do NOT use:
#   - "Direct connection" (db.<project-ref>.supabase.co) — this is
#     IPv6-only, and most hosts (Render, Vercel, GitHub Actions, etc.)
#     have no outbound IPv6 route, so it fails with ENETUNREACH.
#   - "Transaction pooler" (port 6543) — this app runs real
#     multi-statement BEGIN/COMMIT transactions for survey saves, which
#     transaction-mode pooling can break.
# The Session pooler is IPv4-reachable AND supports real transactions.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# --- CORS (frontend origin) ---

# The Vercel URL(s) allowed to call this API cross-origin. Comma-
# separate multiple values (e.g. your production domain + a Vercel
# preview URL). Leave unset to allow any origin (fine for local dev,
# not recommended once this is a public backend).
CORS_ORIGIN=https://your-frontend.vercel.app

# --- AUTH ---

# API write key you generate yourself — there's no provider for this.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When set, every data-write endpoint (add/edit/delete buildings,
# nodes, edges, POIs) requires an "x-api-key" header matching this
# value. Leave blank/unset to run in open/dev mode (no auth).
API_KEY=
