# FindMyBlock — environment configuration
# Copy this file to ".env" and fill in the values below.
# (The server reads these at startup; .env is git-ignored.)
# This app has no third-party services (no DB server, no auth provider,
# no payments, no email) — everything below is all it needs to run.

# --- SERVER ---

# Port the web server listens on.
PORT=3000

# Trust the reverse proxy in front of the app (Render, Railway, Heroku,
# nginx, etc.) so express-rate-limit reads the real client IP from
# X-Forwarded-For instead of the proxy's IP. Leave unset for local dev.
# Common values: 1 (trust one hop) or "loopback" (trust only localhost).
TRUST_PROXY=

# --- DATABASE (SQLite via sql.js) ---

# Path to the SQLite database file. Leave blank to use ./faculty.db.
FACULTY_DB_PATH=

# --- AUTH ---

# API write key. When set, every data-write endpoint (add/edit/delete
# buildings, nodes, edges, POIs) requires an "x-api-key" header matching
# this value. Leave blank/unset to run in open/dev mode (no auth).
API_KEY=
